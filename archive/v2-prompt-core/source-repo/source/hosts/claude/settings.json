{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/.claude/hooks/harness_hook.py\" SessionStart",
            "timeout": 20,
            "statusMessage": "중앙 정책과 브랜치 컨텍스트 확인"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/.claude/hooks/harness_hook.py\" PreToolUse",
            "timeout": 10,
            "statusMessage": "중앙 정책과 작업 브랜치 규칙 확인"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/.claude/hooks/harness_hook.py\" Stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
