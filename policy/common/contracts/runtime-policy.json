{
  "version": 4,
  "roles": {
    "logic": {
      "canonical": "logic"
    },
    "ui": {
      "canonical": "ui"
    },
    "orchest": {
      "canonical": "orchestration"
    },
    "review": {
      "canonical": "review"
    },
    "generate": {
      "canonical": "integrated"
    }
  },
  "hosts": {
    "codex": {
      "artifact_root": ".codex/logs/sessions"
    },
    "claude": {
      "artifact_root": ".claude/logs/sessions"
    },
    "opencode": {
      "artifact_root": ".opencode/logs/sessions"
    },
    "unknown": {
      "artifact_root": ".agent-policy/logs/unknown/sessions"
    }
  },
  "artifacts": {
    "required": [
      "plan.md",
      "final-summary.md"
    ],
    "handoff": "handoff.md",
    "unknown_directory": "unknown",
    "responsibilities": [
      "owner",
      "contributor"
    ],
    "optional": [
      "exploration.md",
      "implementation-log.md",
      "grill-me-review.md",
      "review-log.md",
      "evaluation-log.md",
      "portfolio-log.md"
    ]
  },
  "task_states": [
    "IDLE",
    "ACTIVE",
    "READY_TO_MERGE",
    "MERGED_VERIFIED",
    "CLOSED",
    "PRESERVED"
  ],
  "git": {
    "never_agent_commands": [],
    "validation_commands": [
      "{{LINT_COMMAND}}",
      "{{TEST_COMMAND}}",
      "{{BUILD_COMMAND}}"
    ],
    "access": "shared-project"
  },
  "capabilities": {
    "source_write": [
      "logic",
      "ui",
      "generate"
    ],
    "artifact_write": [
      "logic",
      "ui",
      "orchest",
      "review",
      "generate"
    ],
    "git_write": "user-approved-operation"
  }
}
