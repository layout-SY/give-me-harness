      "pnpm preview": "ask",
      "pnpm preview *": "ask",
      "yarn dev": "ask",
      "yarn dev *": "ask",
      "yarn start": "ask",
      "yarn start *": "ask",
      "yarn preview": "ask",
      "yarn preview *": "ask",
      "bun run dev": "ask",
      "bun run dev *": "ask",
      "bun run start": "ask",
      "bun run start *": "ask",
      "bun run preview": "ask",
      "bun run preview *": "ask",
      "vite": "ask",
