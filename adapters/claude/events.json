{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "session-start",
          "timeout": 15
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "user-prompt",
          "timeout": 10
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "pre-tool",
          "timeout": 60
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "post-tool",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "format-stop",
          "timeout": 15
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "collect-logs",
          "timeout": 30
        }
      ]
    }
  ],
  "PostToolUseFailure": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "post-tool",
          "timeout": 10
        }
      ]
    }
  ]
}
